{
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.linkedProjects": ["coordinator/Cargo.toml"],
  "dotnet.defaultSolution": "plugin/NpcBridge.csproj",
  "python.defaultInterpreterPath": "${workspaceFolder}/sim/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["sim"]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rust: build",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}/coordinator"
      },
      "group": "build",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust: test",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}/coordinator"
      },
      "group": "test",
      "problemMatcher": "$rustc"
    },
    {
      "label": "rust: clippy",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "options": {
        "cwd": "${workspaceFolder}/coordinator"
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "plugin: build",
      "type": "shell",
      "command": "dotnet build plugin/NpcBridge.csproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "sim: test",
      "type": "shell",
      "command": "${workspaceFolder}/sim/.venv/Scripts/python.exe -m pytest sim",
      "problemMatcher": []
    },
    {
      "label": "check all",
      "dependsOn": [
        "rust: clippy",
        "rust: test",
        "plugin: build",
        "sim: test"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "plugin: deploy",
      "type": "shell",
      "command": "scp plugin/scripts/*.cs dom@10.10.10.129:/home/rust/server/carbon/plugins/",
      "problemMatcher": []
    }
  ]
}
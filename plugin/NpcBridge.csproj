<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional machine-specific overrides (gitignored): plugin/local.props -->
  <Import Project="local.props" Condition="Exists('local.props')" />

  <!-- VERIFY target framework and references against the current Carbon docs. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameManaged Condition="'$(GameManaged)' == ''">E:\Code\dev\rust_managed\managed</GameManaged>
    <CarbonManaged Condition="'$(CarbonManaged)' == ''">E:\Code\dev\carbon_managed\managed</CarbonManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Facepunch.UnityEngine"><HintPath>$(GameManaged)\Facepunch.UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Facepunch.Network"><HintPath>$(GameManaged)\Facepunch.Network.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rust.Data"><HintPath>$(GameManaged)\Rust.Data.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

<ItemGroup>
  <Reference Include="Carbon.Common"><HintPath>$(CarbonManaged)\Carbon.Common.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Carbon"><HintPath>$(CarbonManaged)\Carbon.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Carbon.SDK"><HintPath>$(CarbonManaged)\Carbon.SDK.dll</HintPath><Private>false</Private></Reference>
</ItemGroup>
</Project>
